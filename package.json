{
  "name": "abicorp-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Núcleo local y modular del ERP de Abicorp",
  "scripts": {
    "dev": "node --watch src/erp-server.js",
    "start": "node src/erp-server.js",
    "reset-admin": "node scripts/reset-admin.js",
    "migrate:postgres": "node scripts/migrate-sqlite-to-postgres.mjs",
    "test": "node --test",
    "check": "node --check src/erp-server.js"
  },
  "engines": {
    "node": ">=22.5 <25"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1102.0",
    "fast-xml-parser": "5.10.1",
    "pg": "^8.22.0",
    "xlsx": "0.18.5"
  }
}
